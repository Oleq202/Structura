{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"jsx": "react",
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"strict": false,
		"noEmit": true,
		"checkJs": false
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
