# Database Connection
DATABASE_URL=postgresql://user:password@localhost:5432/structura_db

# Security & JWT Configuration
# In production, generate a secure 64-character hex secret using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-cryptographically-secure-random-32-char-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Environment Mode: 'development' | 'production'
ENVIRONMENT=development
COOKIE_SECURE=false

# CORS & Allowed Frontend Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database Connection Pool Configuration
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30.0

# Optional: Sentry Monitoring DSN
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Optional: Redis URL for distributed rate limiting across multiple worker processes.
# Without this, rate limiting is per-process (in-memory). Safe to omit in development.
# REDIS_URL=redis://localhost:6379/0

# Optional: Comma-separated list of trusted reverse-proxy IPs.
# Only when the direct client IP is in this list will X-Forwarded-For be trusted
# for rate limiting. Leave empty (default) in development.
# TRUSTED_PROXIES=10.0.0.1,10.0.0.2
